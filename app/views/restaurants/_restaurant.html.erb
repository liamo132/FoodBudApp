<div id="<%= dom_id restaurant %>">
  <div>
    <strong>Name:</strong>
    <%= restaurant.name %>
  </div>

  <div>
    <strong>Cuisine:</strong>
    <%= restaurant.cuisine %>
  </div>

  <div>
    <strong>Address:</strong>
    <%= restaurant.address %>
  </div>

  <div>
    <strong>Website:</strong>
    <%= restaurant.website %>
  </div>

  <div>
    <strong>Latitude:</strong>
    <%= restaurant.latitude %>
  </div>

  <div>
    <strong>Longitude:</strong>
    <%= restaurant.longitude %>
  </div>

  <div>
    <strong>User added:</strong>
    <%= restaurant.user_added %>
  </div>

</div>
