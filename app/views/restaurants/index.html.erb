<h1>FoodBud</h1>

<!-- Show search info if user searched -->
<% if params[:keyword].present? %>
  <div class="alert alert-info">
    Showing results for: <strong><%= params[:keyword] %></strong>
    <% if params[:latitude].present? && params[:longitude].present? %>
      within <strong><%= params[:radius] %> km</strong> of your location 📍
    <% end %>
  </div>
<% end %>

<!-- Three Tabs: Search Results (Google), Saved Places, User Added -->
<ul class="nav nav-tabs mb-3" id="restaurantTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" id="search-results-tab" data-bs-toggle="tab" data-bs-target="#search-results" type="button" role="tab">
      Search Results <span class="badge bg-warning text-dark" id="googlePlacesCount">0</span>
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="saved-tab" data-bs-toggle="tab" data-bs-target="#saved" type="button" role="tab">
      Saved Places (<%= @restaurants.where(user_added: false).count %>)
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="user-added-tab" data-bs-toggle="tab" data-bs-target="#user-added" type="button" role="tab">
      User Added (<%= @restaurants.where(user_added: true).count %>)
    </button>
  </li>
</ul>

<!-- Map (always visible) -->
<div class="mb-4">
  <%= render 'map' %>
</div>

<!-- Tab Content -->
<div class="tab-content" id="restaurantTabContent">
  <!-- Search Results Tab (Google Places) -->
  <div class="tab-pane fade show active" id="search-results" role="tabpanel">
    <div id="googlePlacesList">
      <p class="text-muted">Search for restaurants to see Google Places results here!</p>
    </div>
  </div>

  <!-- Saved Places Tab (Database restaurants, not user-added) -->
  <div class="tab-pane fade" id="saved" role="tabpanel">
    <% saved_restaurants = @restaurants.where(user_added: false) %>
    <% if saved_restaurants.any? %>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Name</th>
            <th>Cuisine</th>
            <th>Address</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% saved_restaurants.order(:name).each do |restaurant| %>
            <tr>
              <td><%= restaurant.name %></td>
              <td><%= restaurant.cuisine %></td>
              <td><%= restaurant.address %></td>
              <td>
                <%= link_to "Show", restaurant, class: "btn btn-sm btn-info" %>
                <%= link_to "Edit", edit_restaurant_path(restaurant), class: "btn btn-sm btn-warning" %>
                <%= link_to "Delete", restaurant, method: :delete, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="alert alert-info">No saved restaurants yet.</div>
    <% end %>
  </div>

  <!-- User Added Tab -->
  <div class="tab-pane fade" id="user-added" role="tabpanel">
    <% user_added_restaurants = @restaurants.where(user_added: true) %>
    <% if user_added_restaurants.any? %>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Name</th>
            <th>Cuisine</th>
            <th>Address</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% user_added_restaurants.order(created_at: :desc).each do |restaurant| %>
            <tr>
              <td><%= restaurant.name %></td>
              <td><%= restaurant.cuisine %></td>
              <td><%= restaurant.address %></td>
              <td>
                <%= link_to "Show", restaurant, class: "btn btn-sm btn-info" %>
                <%= link_to "Edit", edit_restaurant_path(restaurant), class: "btn btn-sm btn-warning" %>
                <%= link_to "Delete", restaurant, method: :delete, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="alert alert-info">
        No user-added restaurants yet. Click "Add Restaurant" and check the "User added" box to add your own!
      </div>
    <% end %>
  </div>
</div>